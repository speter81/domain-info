{
  "name": "speter81/domain-info",
  "description": "A PHP 8.1+ library for querying domain registration information (expiry, registrar, nameservers, etc.) via TLD-specific strategies with whois fallback.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "domain",
    "whois",
    "rdap",
    "dns",
    "registrar"
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-libxml": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.63"
  },
  "autoload": {
    "psr-4": {
      "SPeter81\\DomainInfo\\": "src/"
    },
    "files": [
      "src/helper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "SPeter81\\DomainInfo\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}